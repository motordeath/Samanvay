generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationOperationalRegion {
  id             String       @id @default(uuid())
  organizationId String
  regionName     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Organization {
  id                          String                          @id @default(uuid())
  name                        String
  legalName                   String                          @default("")
  displayName                 String?
  registrationType            String                          @default("")
  registrationNumber          String                          @unique @default(uuid())
  registeredOfficeAddressLine String                          @default("")
  registeredOfficeState       String                          @default("")
  registeredOfficeDistrict    String?
  verificationStatus          VerificationStatus              @default(UNVERIFIED)
  type                        String
  sector                      String
  description                 String?
  location                    String?
  verified                    Boolean                         @default(false)
  status                      String                          @default("ACTIVE")
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  AuditLog                    AuditLog[]
  events                      Event[]
  financialLedgerEntries      FinancialLedgerEntry[]
  memberships                 Membership[]
  operationalRegions          OrganizationOperationalRegion[]
  partnerships                Partnership[]                   @relation("RequestingOrg")
  targetedBy                  Partnership[]                   @relation("TargetOrg")
  reservations                Reservation[]
  resourceLots                ResourceLot[]
  resourceNeeds               ResourceNeed[]
  resourceOffers              ResourceOffer[]
  transfersFrom               Transfer[]                      @relation("TransferFromOrg")
  transfersTo                 Transfer[]                      @relation("TransferToOrg")
  assignments                 VolunteerAssignment[]
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  AuditLog     AuditLog[]
  memberships  Membership[]
  volunteer    Volunteer?
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model Partnership {
  id                       String       @id @default(uuid())
  requestingOrganizationId String
  targetOrganizationId     String
  status                   String       @default("PENDING")
  requestedById            String
  createdById              String?
  updatedById              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  requestingOrganization   Organization @relation("RequestingOrg", fields: [requestingOrganizationId], references: [id])
  targetOrganization       Organization @relation("TargetOrg", fields: [targetOrganizationId], references: [id])

  @@unique([requestingOrganizationId, targetOrganizationId])
}

model Event {
  id                     String                 @id @default(uuid())
  organizationId         String
  title                  String
  type                   String
  description            String?
  startDate              DateTime
  endDate                DateTime
  status                 EventStatus            @default(DRAFT)
  createdById            String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation(fields: [organizationId], references: [id])
  financialLedgerEntries FinancialLedgerEntry[]
  reservations           Reservation[]
  resourceNeeds          ResourceNeed[]
  volunteerNeeds         VolunteerNeed[]
}

model Resource {
  id                     String                 @id @default(uuid())
  name                   String                 @unique
  description            String?
  unit                   String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  inventoryLedgerEntries InventoryLedgerEntry[]
  reservations           Reservation[]
  lots                   ResourceLot[]
  needs                  ResourceNeed[]
  transfers              Transfer[]
}

model ResourceLot {
  id                String          @id @default(uuid())
  organizationId    String
  resourceId        String
  quantity          Int
  availableQuantity Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reservedQuantity  Int             @default(0)
  organization      Organization    @relation(fields: [organizationId], references: [id])
  resource          Resource        @relation(fields: [resourceId], references: [id])
  offers            ResourceOffer[]
}

model ResourceNeed {
  id             String          @id @default(uuid())
  organizationId String
  eventId        String?
  resourceId     String
  quantity       Int
  notes          String?
  status         String          @default("OPEN")
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  event          Event?          @relation(fields: [eventId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  resource       Resource        @relation(fields: [resourceId], references: [id])
  offers         ResourceOffer[]
  transfers      Transfer[]
}

model ResourceOffer {
  id                     String       @id @default(uuid())
  needId                 String
  offeringOrganizationId String
  resourceLotId          String
  offeredQuantity        Int
  notes                  String?
  status                 String       @default("PENDING")
  createdById            String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  need                   ResourceNeed @relation(fields: [needId], references: [id])
  offeringOrganization   Organization @relation(fields: [offeringOrganizationId], references: [id])
  resourceLot            ResourceLot  @relation(fields: [resourceLotId], references: [id])
  transfers              Transfer[]
}

model Transfer {
  id                     String                  @id @default(uuid())
  needId                 String
  offerId                String
  resourceId             String
  fromOrganizationId     String
  toOrganizationId       String
  quantity               Int
  status                 TransferStatus          @default(PENDING)
  approvedById           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  financialLedgerEntries FinancialLedgerEntry[]
  ledgerEntries          InventoryLedgerEntry[]
  allocations            ReservationAllocation[]
  fromOrganization       Organization            @relation("TransferFromOrg", fields: [fromOrganizationId], references: [id])
  need                   ResourceNeed            @relation(fields: [needId], references: [id])
  offer                  ResourceOffer           @relation(fields: [offerId], references: [id])
  resource               Resource                @relation(fields: [resourceId], references: [id])
  toOrganization         Organization            @relation("TransferToOrg", fields: [toOrganizationId], references: [id])
}

model Reservation {
  id                     String                  @id @default(uuid())
  organizationId         String
  resourceId             String
  eventId                String?
  transferId             String?
  requestedQuantity      Int
  reservedQuantity       Int                     @default(0)
  allocatedQuantity      Int                     @default(0)
  status                 ReservationStatus       @default(PENDING)
  expiresAt              DateTime?
  createdById            String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  financialLedgerEntries FinancialLedgerEntry[]
  ledgerEntries          InventoryLedgerEntry[]
  event                  Event?                  @relation(fields: [eventId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id])
  resource               Resource                @relation(fields: [resourceId], references: [id])
  allocations            ReservationAllocation[]
}

model ReservationAllocation {
  id            String      @id @default(uuid())
  reservationId String
  transferId    String
  quantity      Int
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  transfer      Transfer    @relation(fields: [transferId], references: [id])
}

model InventoryLedgerEntry {
  id            String              @id @default(uuid())
  resourceId    String
  reservationId String?
  transferId    String?
  type          InventoryLedgerType
  quantity      Int
  createdById   String
  createdAt     DateTime            @default(now())
  reservation   Reservation?        @relation(fields: [reservationId], references: [id])
  resource      Resource            @relation(fields: [resourceId], references: [id])
  transfer      Transfer?           @relation(fields: [transferId], references: [id])
}

model FinancialLedgerEntry {
  id             String       @id @default(uuid())
  organizationId String
  eventId        String?
  transferId     String?
  reservationId  String?
  type           String
  amount         Decimal      @db.Decimal(18, 2)
  currency       String       @default("USD")
  metadata       Json?
  createdAt      DateTime     @default(now())
  event          Event?       @relation(fields: [eventId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  transfer       Transfer?    @relation(fields: [transferId], references: [id])
}

model AuditLog {
  id             String          @id @default(uuid())
  action         AuditAction
  userId         String?
  organizationId String?
  entityType     AuditEntityType
  entityId       String
  metadata       Json?
  createdAt      DateTime        @default(now())
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
}

model VolunteerOperationalRegion {
  id          String    @id @default(uuid())
  volunteerId String
  regionName  String
  createdAt   DateTime  @default(now())
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model Volunteer {
  id                 String                       @id @default(uuid())
  userId             String                       @unique
  fullName           String                       @default("")
  phoneNumber        String                       @default("")
  verificationStatus VerificationStatus           @default(UNVERIFIED)
  homeLocation       String?
  bio                String?
  location           String?
  experienceYears    Int?
  isAvailable        Boolean                      @default(true)
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments        VolunteerAssignment[]
  availability       VolunteerAvailability[]
  certifications     VolunteerCertification[]
  invitations        VolunteerInvitation[]
  operationalRegions VolunteerOperationalRegion[]
  skills             VolunteerSkill[]
}

model Skill {
  id         String               @id @default(uuid())
  name       String               @unique
  needSkills VolunteerNeedSkill[]
  volunteers VolunteerSkill[]
}

model VolunteerSkill {
  id          String     @id @default(uuid())
  volunteerId String
  skillId     String
  level       SkillLevel
  skill       Skill      @relation(fields: [skillId], references: [id])
  volunteer   Volunteer  @relation(fields: [volunteerId], references: [id])

  @@unique([volunteerId, skillId])
}

model Certification {
  id         String                   @id @default(uuid())
  name       String                   @unique
  volunteers VolunteerCertification[]
}

model VolunteerCertification {
  id              String        @id @default(uuid())
  volunteerId     String
  certificationId String
  issuedAt        DateTime?
  expiresAt       DateTime?
  certification   Certification @relation(fields: [certificationId], references: [id])
  volunteer       Volunteer     @relation(fields: [volunteerId], references: [id])

  @@unique([volunteerId, certificationId])
}

model VolunteerAvailability {
  id          String    @id @default(uuid())
  volunteerId String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isDeleted   Boolean   @default(false)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
}

model VolunteerNeed {
  id             String                @id @default(uuid())
  organizationId String
  eventId        String?
  title          String
  description    String?
  requiredCount  Int
  location       String?
  startDate      DateTime
  endDate        DateTime
  status         VolunteerNeedStatus   @default(OPEN)
  createdBy      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assignments    VolunteerAssignment[]
  invitations    VolunteerInvitation[]
  event          Event?                @relation(fields: [eventId], references: [id])
  skills         VolunteerNeedSkill[]

  @@index([status])
  @@index([organizationId])
}

model VolunteerNeedSkill {
  id            String        @id @default(uuid())
  needId        String
  skillId       String
  requiredLevel SkillLevel
  need          VolunteerNeed @relation(fields: [needId], references: [id])
  skill         Skill         @relation(fields: [skillId], references: [id])

  @@unique([needId, skillId])
}

model VolunteerInvitation {
  id          String           @id @default(uuid())
  volunteerId String
  needId      String
  status      InvitationStatus @default(PENDING)
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  need        VolunteerNeed    @relation(fields: [needId], references: [id])
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id])

  @@unique([volunteerId, needId])
  @@index([volunteerId])
  @@index([needId])
  @@index([status])
}

model VolunteerAssignment {
  id             String               @id @default(uuid())
  volunteerId    String
  needId         String?
  status         AssignmentStatus     @default(ASSIGNED)
  assignedAt     DateTime             @default(now())
  completedAt    DateTime?
  createdBy      String
  endDate        DateTime?
  location       String?
  notes          String?
  organizationId String?
  startDate      DateTime             @default(now())
  title          String               @default("General Assignment")
  need           VolunteerNeed?       @relation(fields: [needId], references: [id], onDelete: Restrict)
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  volunteer      Volunteer            @relation(fields: [volunteerId], references: [id])
  attendance     VolunteerAttendance?

  @@unique([volunteerId, needId])
  @@index([volunteerId])
  @@index([needId])
  @@index([status])
}

model VolunteerAttendance {
  id                 String              @id @default(uuid())
  assignmentId       String              @unique
  checkInTime        DateTime?
  checkOutTime       DateTime?
  verifiedBy         String?
  verificationMethod String?
  assignment         VolunteerAssignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

model VolunteerAudit {
  id          String   @id @default(uuid())
  volunteerId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  type           String
  title          String
  body           String
  isRead         Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
}

model ActivityEvent {
  id             String   @id @default(uuid())
  type           String
  actorId        String?
  organizationId String?
  operationId    String?
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([operationId])
  @@index([createdAt])
  @@index([actorId])
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  MEMBERSHIP_CREATED
  MEMBERSHIP_STATUS_UPDATED
  ORGANIZATION_UPDATED
  EVENT_CREATED
  EVENT_UPDATED
  RESOURCE_NEED_CREATED
  RESOURCE_NEED_CANCELLED
  RESOURCE_OFFER_CREATED
  RESOURCE_OFFER_ACCEPTED
  RESOURCE_OFFER_REJECTED
  RESOURCE_OFFER_WITHDRAWN
  TRANSFER_CREATED
  TRANSFER_APPROVED
  TRANSFER_COMPLETED
  TRANSFER_CANCELLED
  RESERVATION_CREATED
  RESERVATION_CANCELLED
  RESERVATION_EXPIRED
  LEDGER_ENTRY_ADDED
}

enum AuditEntityType {
  USER
  MEMBERSHIP
  ORGANIZATION
  EVENT
  RESOURCE_NEED
  RESOURCE_OFFER
  TRANSFER
  RESERVATION
  INVENTORY_LEDGER
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
  FAILED
}

enum ReservationStatus {
  PENDING
  RESERVED
  PARTIALLY_ALLOCATED
  ALLOCATED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum InventoryLedgerType {
  STOCK_IN
  STOCK_OUT
  RESERVATION_HOLD
  RESERVATION_RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum VolunteerNeedStatus {
  OPEN
  FILLED
  CLOSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AssignmentStatus {
  ASSIGNED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
}
